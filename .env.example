PORT=3000
NODE_ENV=production

# Dashboard Login
DASHBOARD_USERNAME=ampwake
DASHBOARD_PASSWORD=yourpassword

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# OpenAI Image Generation
OPENAI_API_KEY=

# Google OAuth + GBP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/callback

# SerpAPI (for keyword research)
SERP_API_KEY=

# Zoho SMTP (or any SMTP provider)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GMB Reports <noreply@yourdomain.com>

# App base URL
APP_URL=https://yourdomain.com
